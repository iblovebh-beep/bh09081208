{
  "entities": {
    "Order": {
      "title": "Order",
      "description": "고객의 생식 제품 주문 내역",
      "type": "object",
      "properties": {
        "orderId": {
          "type": "string",
          "description": "주문 고유 식별 번호",
          "minLength": 4,
          "maxLength": 64
        },
        "customerName": {
          "type": "string",
          "description": "주문 고객 성함",
          "minLength": 1,
          "maxLength": 50
        },
        "phone": {
          "type": "string",
          "description": "고객 연락처 전화번호",
          "minLength": 8,
          "maxLength": 20
        },
        "address": {
          "type": "string",
          "description": "배송지 기본 주소 및 상세 주소",
          "minLength": 2,
          "maxLength": 200
        },
        "deliveryRequest": {
          "type": "string",
          "description": "배송 시 요청사항",
          "maxLength": 100
        },
        "packageOptionId": {
          "type": "string",
          "description": "선택한 패키지 상품 ID",
          "maxLength": 30
        },
        "packageName": {
          "type": "string",
          "description": "선택한 상품명",
          "minLength": 2,
          "maxLength": 100
        },
        "pouchCount": {
          "type": "number",
          "description": "주문 포 수량"
        },
        "totalPrice": {
          "type": "number",
          "description": "총 결제 금액"
        },
        "paymentMethod": {
          "type": "string",
          "description": "결제 방식",
          "maxLength": 50
        },
        "status": {
          "type": "string",
          "description": "주문 처리 상태",
          "enum": ["접수완료", "배송준비", "배송중", "배송완료", "주문취소"]
        },
        "createdAt": {
          "type": "string",
          "description": "주문 생성 일시 (ISO 형식)"
        },
        "updatedAt": {
          "type": "string",
          "description": "주문 수정 일시 (ISO 형식)"
        }
      },
      "required": [
        "orderId",
        "customerName",
        "phone",
        "address",
        "packageOptionId",
        "packageName",
        "totalPrice",
        "paymentMethod",
        "status",
        "createdAt"
      ]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "회원 프로필 정보",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "회원 고유 ID"
        },
        "email": {
          "type": "string",
          "description": "회원 이메일"
        },
        "displayName": {
          "type": "string",
          "description": "회원 성함"
        },
        "password": {
          "type": "string",
          "description": "회원 비밀번호"
        },
        "createdAt": {
          "type": "string",
          "description": "가입 일시"
        }
      },
      "required": ["uid", "email", "displayName"]
    }
  },
  "firestore": {
    "/orders/{orderId}": {
      "schema": {
        "$ref": "Order"
      },
      "description": "고객 생식 주문 컬렉션"
    },
    "/users/{userId}": {
      "schema": {
        "$ref": "UserProfile"
      },
      "description": "회원 프로필 컬렉션"
    }
  }
}
